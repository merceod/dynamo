FROM node:24.10.0-bookworm-slim@sha256:b8d2197aff9129d16c801a3e3e1b2a873c4946480f5a310f38056df2268c38d9

ARG DYNAMO_RECIPE_COMMIT=unknown
ARG PNPM_VERSION=11.7.0

WORKDIR /opt/dynamo/examples/agent_harnesses/deepseek_harness/client
COPY examples/agent_harnesses/deepseek_harness/client/package.json examples/agent_harnesses/deepseek_harness/client/pnpm-lock.yaml ./
RUN corepack pnpm@${PNPM_VERSION} install --prod --frozen-lockfile --ignore-scripts
COPY examples/agent_harnesses/deepseek_harness/client/drive_deepseek_harness_acp.mjs examples/agent_harnesses/deepseek_harness/client/run_deepseek_harness_acp_server.mjs ./
COPY .agents/skills/dynamo-agent-harness/scripts/drive_deepseek_harness.mjs /opt/dynamo/.agents/skills/dynamo-agent-harness/scripts/drive_deepseek_harness.mjs

LABEL org.opencontainers.image.revision="${DYNAMO_RECIPE_COMMIT}" \
      org.opencontainers.image.source="https://github.com/ai-dynamo/dynamo"
USER node
ENTRYPOINT ["node", "/opt/dynamo/examples/agent_harnesses/deepseek_harness/client/drive_deepseek_harness_acp.mjs"]
